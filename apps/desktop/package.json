  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tanstack/svelte-query": "^5.90.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.8.2",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.2"
  }
}
