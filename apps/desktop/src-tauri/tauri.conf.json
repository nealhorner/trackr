{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackr Desktop",
  "version": "0.1.0",
  "identifier": "com.trackr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web -w @trackr/desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web -w @trackr/desktop",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Trackr Desktop",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
