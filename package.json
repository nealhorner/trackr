{
  "name": "trackr",
  "version": "1.0.0",
  "description": "Trackr is an open source, self-hosted alternative ticket and project management tool.",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.5.1",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:e2e": "node scripts/dev-e2e.mjs",
    "dev:e2e-desktop": "node scripts/dev-e2e-desktop.mjs",
    "build": "npm run build:all",
    "build:all": "turbo build",
    "build:desktop": "turbo build --filter=@trackr/desktop",
    "build:web": "turbo build --filter=@trackr/web",
    "build:server": "turbo build --filter=@trackr/server",
    "lint": "turbo lint",
    "test": "npm run test:unit",
    "test:unit": "turbo run test:unit",
    "test:integration": "npm run test:integration -w @trackr/server",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:e2e": "turbo e2e --filter=!@trackr/desktop",
    "test:e2e:changes": "cd apps/server && npx playwright test --only-changed=main",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "check-format": "npm run format:check",
    "format": "npm run format:fix",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nealhorner/trackr.git"
  },
  "keywords": [
    "trackr",
    "project management",
    "ticket management",
    "task management",
    "kanban",
    "scrum",
    "agile"
  ],
  "author": "Neal Horner",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nealhorner/trackr/issues"
  },
  "homepage": "https://github.com/nealhorner/trackr#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.20",
    "wait-on": "^8.0.1",
    "typescript": "^6.0.2",
    "varlock": "^1.1.0",
    "vitest": "^4.1.2"
  }
}
