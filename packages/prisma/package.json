{
  "name": "@trackr/prisma",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./generated/client-postgres/index.js",
    "./postgres": "./generated/client-postgres/index.js",
    "./sqlite": "./generated/client-sqlite/index.js"
  },
  "scripts": {
    "seed": "tsx seed.ts",
    "seed:sqlite": "tsx seed-sqlite.ts",
    "build": "npm run generate:all",
    "generate:postgres": "prisma generate --schema prisma/postgres/schema.prisma",
    "generate:sqlite": "cross-env SQLITE_DATABASE_URL=file:./.local/trackr.sqlite prisma generate --config prisma.config.sqlite.ts",
    "generate:all": "npm run generate:postgres && npm run generate:sqlite",
    "migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "migrate:deploy:sqlite": "cross-env SQLITE_DATABASE_URL=file:./.local/trackr.sqlite prisma migrate deploy --config prisma.config.sqlite.ts",
    "db:push:sqlite": "cross-env SQLITE_DATABASE_URL=file:./.local/trackr.sqlite prisma db push --config prisma.config.sqlite.ts"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "cross-env": "^7.0.3",
    "prisma": "^7.5.0",
    "tsx": "^4.19.0"
  },
  "prisma": {
    "seed": "cd ../.. && npm run seed -w @trackr/server"
  },
  "dependencies": {
    "varlock": "^0.9.1"
  }
}
